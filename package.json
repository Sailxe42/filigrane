{
  "name": "filigrane-monorepo",
  "private": true,
  "type": "module",
  "description": "Open-source toolkit to make AI apps transparent: EU AI Act Article 50 marking, labelling and verification.",
  "license": "MIT",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -b packages/core packages/ui packages/cli",
    "typecheck": "tsc -b packages/core packages/ui packages/cli",
    "test": "vitest run",
    "interop": "node scripts/interop.mjs",
    "dev:site": "npm run dev -w apps/site",
    "build:site": "npm run build -w apps/site"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "happy-dom": "^21.0.3",
    "sharp": "^0.35.5",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
